# Entorno: 'development' (escribe en disco local) o 'production' (usa GitHub API)
ENVIRONMENT=development

# Configuración del Administrador
ADMIN_USERNAME=ignacio
# Genera tu hash con: python -c "import bcrypt; print(bcrypt.hashpw(b'tu_contraseña_maestra', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$ZcoznLX0.qD3N48TkySQrOEZXliYHTuwongcHwl2g9rX4e8ACDlgu

# Clave secreta para firmar tokens JWT
JWT_SECRET=tu-clave-secreta-jwt-super-segura

# GitOps / GitHub API (Obligatorio en producción para commits automáticos a GitHub Pages)
GITHUB_TOKEN=ghp_tu_personal_access_token_aqui
GITHUB_REPO=igarbayo/web-personal
GITHUB_BRANCH=main

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://ignaciogarbayo.com"]
