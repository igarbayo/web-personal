#!/bin/sh
# Build completo antes de push. Es la última red antes de que un push a `main`
# dispare el deploy de Pages, así que aquí sí compensa pagar los ~40 s.
#
# Saltar puntualmente:  SKIP_HOOKS=1 git push ...
set -e

[ "$SKIP_HOOKS" = "1" ] && { echo "pre-push: saltado (SKIP_HOOKS=1)"; exit 0; }

cd "$(git rev-parse --show-toplevel)/src/frontend"

if [ ! -d node_modules ]; then
  echo "pre-push: falta node_modules en src/frontend — ejecuta 'pnpm install'" >&2
  exit 1
fi

echo "pre-push: build"
pnpm run --silent build

echo "pre-push: ok"
